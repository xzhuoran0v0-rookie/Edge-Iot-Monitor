# ============================================================
# Edge-Intelligence IoT Monitor — .gitignore
# ============================================================

# --- Build artifacts ---
build/
build-cmake/
cmake-build-*/
backend/backend/
backend/build-mingw/
*.o
*.a
*.so
*.out
*.exe
*.elf
*.bin
*.hex
*.map
*.bak
server.err

# --- CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
install_manifest.txt
CTestTestfile.cmake

# --- ESP-IDF / PlatformIO ---
.pio/
.vscode/
sdkconfig
sdkconfig.old
dependencies.lock
managed_components/
esp-idf/

# --- Secrets & local config (never commit real credentials) ---
config/config.yaml
firmware/src/config.h
firmware/iotda_mvp/src/config.h
docs/iotda_activation_local.md
*.env
.env.*
secrets.yaml
*.pem
*.key

# --- Local data (sensor databases) ---
*.db
*.sqlite
*.sqlite3

# --- MySQL dumps (can contain sensitive data) ---
*.sql.gz
dump_*.sql

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# --- Logs ---
*.log
*.err
logs/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.idea/
*.swp
*.swo
*~
